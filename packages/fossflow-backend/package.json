{
  "name": "fossflow-backend",
  "version": "1.0.6",
  "description": "Optional backend server for FossFLOW: diagram storage and live data sources",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ext js,ts server.js",
    "test": "node --test 'live/**/*.test.ts'",
    "lint": "tsc -p .",
    "dev:fake-beszel": "node live/testing/runFakeBeszel.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "nodemon": "^3.1.14"
  }
}
