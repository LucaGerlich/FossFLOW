# Local development of the server (`npm run dev:backend` from the repo root).
# Copy to `.env` in this folder; it is gitignored and never copied into images.

# Start the dev database first: npm run dev:db
DATABASE_URL=postgres://fossflow:fossflow-dev@127.0.0.1:54320/fossflow

# Optional: live data from a Beszel hub (moves into encrypted credentials later in phase 1).
# BESZEL_URL=
# BESZEL_EMAIL=
# BESZEL_PASSWORD=
