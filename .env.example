# Server Storage Configuration
# Set to true to enable server-side storage for multi-device access
# Default is true - diagrams are saved to ./diagrams directory on the host
ENABLE_SERVER_STORAGE=true

# Git backup (optional)
# Set to true to automatically commit changes to git
ENABLE_GIT_BACKUP=false

# Storage path (inside container)
# This is mapped to ./diagrams on the host via Docker volume
STORAGE_PATH=/data/diagrams

# Backend port (usually doesn't need changing)
BACKEND_PORT=3001
# Backend host (use 127.0.0.1 to listen only local connection)
BACKEND_HOST=0.0.0.0

# HTTP Basic Auth (optional)
# setup both USER and PASSWORD to enable authentication
HTTP_AUTH_USER=
HTTP_AUTH_PASSWORD=

# Legacy live-data login. Add live sources under a project's Credentials instead;
# a login set here is moved into a "Beszel" credential once, on first start,
# and can then be removed. Use a Beszel user with the "readonly" role.
BESZEL_URL=
BESZEL_EMAIL=
BESZEL_PASSWORD=
# Or read the password from a file (e.g. a Docker secret) instead:
# BESZEL_PASSWORD_FILE=/run/secrets/beszel_password
# How often the server polls each live source, in seconds (10-3600)
LIVE_POLL_SECONDS=30
