# Copy to .env and fill in. compose.yml reads it; never commit .env.

# Database password, required. Letters and digits only (it goes into a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The address people open FossFLOW at, required (no trailing slash).
# Sign-in, invitation and reset links only work from this origin.
FOSSFLOW_URL=http://localhost

# Host port for the app
PORT=80

# Encryption key for stored credentials (optional, 32 bytes as base64):
#   openssl rand -base64 32
# Left empty, one is generated into ./data/config/encryption-key on first
# start. Back up whichever you use: without it, saved credentials can't be read.
FOSSFLOW_ENCRYPTION_KEY=

# Mail for invitations and password resets (optional). Without it, admins
# copy the links from the Users page and hand them over.
SMTP_HOST=
SMTP_PORT=465
# true for implicit TLS (465), false for STARTTLS (587)
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# HTTP Basic Auth (optional): an extra password prompt in front of the sign-in
# page. Set both to enable.
HTTP_AUTH_USER=
HTTP_AUTH_PASSWORD=

# How often the server polls each live source, in seconds (10-3600)
LIVE_POLL_SECONDS=30

# User and group the server runs as; ./data belongs to them (default 1000:1000)
PUID=
PGID=

# Legacy live-data login. Add live sources under a project's Credentials instead;
# a login set here is moved into a "Beszel" credential once, on first start,
# and can then be removed. Use a Beszel user with the "readonly" role.
BESZEL_URL=
BESZEL_EMAIL=
BESZEL_PASSWORD=
